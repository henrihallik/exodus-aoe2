/* Compatibility: Definitive Edition */
/* EXODUS: SEA OF SIGNS 0.2.2. Original Art of the Map I candidate.
   Tiny / two players / standard dataset / Conquest. Both scripts required.
   Coast roads always open. Seabed x55..64, y44..75: 6 HP/s while flooded.
   Sea opens 12:20, returns 18:00; 18-minute repeating cycle.
   Actual terrain is fixed; XS uses nonblocking Gaia water scenery and a damage hazard. */
#includeXS exodus.xs
#const T0 0
#const T1 1
#const T2 2
#const T4 4
#const T6 6
#const T13 13
#const T14 14
#const T45 45
#const T50 50
#const EX_GOLD 66
#const EX_STONE 102
#const EX_BERRIES 59
#const EX_SHEEP 594
#const EX_BOAR 48
#const EX_DEER 65
#const EX_RELIC 285
#const EX_FISH 458
#const EX_ACACIA 1063
#const EX_PALM 351
#const EX_BUSH 1360
#const EX_WALL 117
#const EX_GATE 1323
#const EX_TORCH 499
#const EX_ROCK 623
#const EX_MOUNTAIN 1048
#const EX_FLOWERS 334
#const EX_GAIA_SET -1
#const EX_SIZE_X 3
#const EX_SIZE_Y 4
#const EX_OBSTRUCTION 78
#const EX_BLOCKAGE 79
#const EX_DESERT_MOOD 4
<PLAYER_SETUP>
direct_placement
behavior_version 1
override_map_size 120
ai_info_map_type MEDITERRANEAN 0 0 0
/* Pre-placement Gaia-only collision and effect settings. */
effect_amount EX_GAIA_SET EX_TORCH EX_OBSTRUCTION 4
